/* ==============================================================================
 * ROFI POWER MENU THEME
 * Horizontal Card View for Lock, Logout, Suspend, Reboot, Shutdown
 * ============================================================================== */

@import "config.rasi"

window {
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      600px;
    border:                     2px solid;
    border-color:               @border-col;
    border-radius:              16px;
    background-color:           rgba(30, 30, 46, 0.95);
}

mainbox {
    spacing:                    20px;
    padding:                    24px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    padding:                    10px;
    border-radius:              10px;
    background-color:           @bg-col-light;
    children:                   [ "prompt" ];
}

prompt {
    background-color:           inherit;
    text-color:                 @mauve;
    font:                       "JetBrainsMono Nerd Font Bold 12";
    horizontal-align:           0.5;
}

listview {
    columns:                    5;
    lines:                      1;
    cycle:                      true;
    scrollbar:                  false;
    layout:                     vertical;
    spacing:                    10px;
    background-color:           transparent;
}

element {
    padding:                    18px 10px;
    border-radius:              12px;
    background-color:           @bg-col-light;
    text-color:                 @fg-col;
    cursor:                     pointer;
    orientation:                vertical;
}

element selected.normal {
    background-color:           @mauve;
    text-color:                 #1e1e2e;
}

element-text {
    font:                       "JetBrainsMono Nerd Font 22";
    background-color:           transparent;
    text-color:                 inherit;
    horizontal-align:           0.5;
    vertical-align:             0.5;
}
