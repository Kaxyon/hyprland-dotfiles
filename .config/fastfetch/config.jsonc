{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "color": {
            "1": "magenta"
        },
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ➜  "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "red"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "magenta"
        },
        "break",
        "colors"
    ]
}
